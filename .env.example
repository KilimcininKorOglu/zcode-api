# docker-compose.yml reads this file (gitignored) for the credential-store
# encryption key. The SAME value must be used for `auth login` and for the
# container, or the stored credentials.json cannot be decrypted:
#
#   ZCODE_PROXY_CREDENTIAL_SECRET="a-secret-passphrase-only-you-know" \
#     bun run src/index.ts auth login zai
ZCODE_PROXY_CREDENTIAL_SECRET=change-me-to-a-long-random-passphrase
